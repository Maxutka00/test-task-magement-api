POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=task_manager
POSTGRES_TEST_USER=postgres
POSTGRES_TEST_PASSWORD=postgres
POSTGRES_TEST_DB=task_manager_test
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/task_manager
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres_test:5432/task_manager_test
REDIS_URL=redis://redis:6379/0
JWT_SECRET_KEY=replace-with-strong-random-secret-at-least-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
INVITATION_EXPIRE_DAYS=7
OVERDUE_CHECK_INTERVAL_SECONDS=60
